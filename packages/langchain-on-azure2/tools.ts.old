import {
    AzureAISearchVectorStore,
    AzureAISearchQueryType,
  } from "@langchain/community/vectorstores/azure_aisearch";
  import { OpenAI } from "langchain/llms/openai";

  import { AzureCognitiveSearchRetriever } from "langchain/retrievers/azure-cognitive-search";
  // Document loaders from LangChain for local files.
  import { TextLoader } from "langchain/document_loaders/fs/text";
  import { PDFLoader } from "@langchain/community/document_loaders/fs/pdf";
  import path from "path";
  import { SearchClient, AzureKeyCredential } from "@azure/search-documents";
  import { RecursiveCharacterTextSplitter } from "@langchain/textsplitters";
  import { ChatOpenAI, OpenAIEmbeddings } from "@langchain/openai";
  import { ingestFilesToAzureSearch } from "./ingest-files";
  // Azure Cognitive Search configuration (replace placeholders)
const AZURE_SEARCH_SERVICE_ENDPOINT = "https://<your-search-service>.search.windows.net";
const AZURE_SEARCH_INDEX = "<your-index-name>";
const AZURE_SEARCH_API_KEY = "<your-azure-search-api-key>";


/**
 * Identifies main topics in documents retrieved via Azure Cognitive Search.
 *
 * This tool uses Azure AI Search to fetch relevant documents and then employs OpenAI
 * to extract the major topics covered in the content.
 *
 * @param query - The search query string.
 * @returns A list of topics extracted from the retrieved documents.
 */
export async function classifyDocumentTopics(query: string): Promise<string> {
  // Retrieve content using the same Azure Cognitive Search retriever.
  const content = await azureAISearch(query);

  // Create a prompt to identify main topics.
  const prompt = `Please identify and list the main topics covered in the following content:\n\n${content}\n\nTopics:`;

  // Instantiate a local LLM for topic extraction.
  const localLLM = new OpenAI({ temperature: 0, openAIApiKey: "YOUR_OPENAI_API_KEY" });
  const topics = await localLLM.call(prompt);
  
  return topics;
}
/**
 * Summarizes documents retrieved via Azure Cognitive Search.
 *
 * This tool first retrieves relevant documents using the Azure Cognitive Search retriever,
 * and then uses OpenAI to summarize the aggregated content.
 *
 * @param query - The search query string.
 * @returns A concise summary of the retrieved content.
 */
export async function summarizeDocuments(query: string): Promise<string> {
  // Retrieve documents using the same retriever function.
  const content = await azureAISearch(query);
  
  // Create a prompt to summarize the content.
  const prompt = `Please provide a concise summary of the following content:\n\n${content}`;
  
  // Instantiate a local LLM for summarization.
  const localLLM = new OpenAI({ temperature: 0, openAIApiKey: "YOUR_OPENAI_API_KEY" });
  const summary = await localLLM.call(prompt);
  
  return summary;
}

/**
 * Integration with Azure Cognitive Search using the LangChain retriever.
 *
 * @param query - The search query string.
 * @returns The aggregated page content from the search results.
 */
export async function azureAISearch(query: string): Promise<string> {
    const retriever = new AzureCognitiveSearchRetriever({
      serviceEndpoint: AZURE_SEARCH_SERVICE_ENDPOINT,
      indexName: AZURE_SEARCH_INDEX,
      apiKey: AZURE_SEARCH_API_KEY,
      apiVersion: "2021-04-30-Preview", // optional: adjust if needed
      top: 3 // Return top 3 results
    });
  
    const results = await retriever.getRelevantDocuments(query);
    return results.map((doc: { pageContent: string }) => doc.pageContent).join("\n");
  }