

    const chatClientOptions: AzureClientOptions = {
        endpoint: `https://${chatOptions.azureOpenAIApiInstanceName}.azure.openai.com/`,
        deployment: chatOptions.azureOpenAIApiDeploymentName,
        apiKey: chatOptions.azureOpenAIApiKey,
        apiVersion: chatOptions.azureOpenAIApiVersion
    };

    const messages = [
        {
          role: "user",
          content:
            "What's the most common feedback we received from our customers about the product?",
        },
      ]


    const chatClient = getAzureChatOpenAI(chatClientOptions);
    const events = getChatCompletions(chatClient, messages);
    console.log(events);

}

main().catch(console.error);
